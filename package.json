{
  "name": "dawa-alert",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Recalled-medicine batch alerts on Arkiv: queryable, expiring, unerasable.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.live.config.ts",
    "seed": "node --env-file-if-exists=.env.local scripts/seed.ts",
    "sync": "npm run data:portal && npm run seed",
    "data:portal": "python3 -I scripts/fetch_portal.py",
    "data:pdf": "python3 -I scripts/fetch_cdsco.py && python3 -I scripts/parse_cdsco.py",
    "stats": "node --env-file-if-exists=.env.local scripts/publish-stats.ts"
  },
  "dependencies": {
    "@arkiv-network/sdk": "^0.8.1",
    "leaflet": "^1.9.4",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "^5.1.1",
    "viem": "^2.57.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
