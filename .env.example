# Copy to .env.local (git-ignored) and fill in. Never commit real values.
PRIVATE_KEY=0x...            # wallet that creates every Arkiv entity; use a fresh testnet key, fund it at hub.arkiv.network/faucet
ARKIV_API_KEY=ark_live_...   # access key from hub.arkiv.network/api-keys (anonymous queries are budget-limited)
# GEMINI_API_KEY=            # optional: enables the opt-in "Try AI reading" button (Gemini vision, server side)
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=         # optional alternative to Gemini (Claude vision)
# ARKIV_RPC=https://rpc.tiramisu.db-chain.testnet.arkiv.network
# RELAY_RATE_PER_HOUR=20
